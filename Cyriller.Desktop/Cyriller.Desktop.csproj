<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.2.0</Version>
    <RootNamespace>Cyriller.Desktop</RootNamespace>
    <AssemblyName>Cyriller.Desktop</AssemblyName>
    <ApplicationIcon>favicon.ico</ApplicationIcon>
    <Description>Настольное приложение Кириллер на Avalonia.</Description>
    <Company>http://www.miyconst.com/</Company>
    <Copyright>Copyright © Konstantin Mi 2014-2020</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaXaml Include="App.xaml" />
    <AvaloniaXaml Include="Views\**\*.xaml" />
    <AvaloniaResource Include="Assets\**" />
    <None Remove="favicon.ico" />
    <AvaloniaResource Include="favicon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.23" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.13" />
    <PackageReference Include="Avalonia.ReactiveUI" Version="11.3.9" />
    <PackageReference Include="EPPlus" Version="4.5.3.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cyriller.Model\Cyriller.Model.csproj" />
    <ProjectReference Include="..\Cyriller.Rule\Cyriller.Rule.csproj" />
    <ProjectReference Include="..\Cyriller\Cyriller.csproj" />
  </ItemGroup>

</Project>
