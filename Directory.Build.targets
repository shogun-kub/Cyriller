<Project>

  <!--
    Avalonia.BuildServices (telemetry и проверка лицензии) пишет свой лог в
    %LOCALAPPDATA%\AvaloniaUI\BuildServices, а песочница агента запрещает запись за пределами
    рабочего каталога — сборка падает с MSB4018 на задаче AvaloniaStats. Целевой объект
    объявляется здесь повторно и пустым: MSBuild оставляет последнее определение, поэтому
    телеметрия не запускается, а XAML-компилятор и лицензионные свойства не затрагиваются.
    При сборке вне песочницы то же самое делается переменной AVALONIA_TELEMETRY_OPTOUT=1.
  -->
  <Target Name="AvaloniaStats" />

</Project>
