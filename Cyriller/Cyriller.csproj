<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.1</TargetFrameworks>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);CopyProjectReferencesToPackage</TargetsForTfmSpecificBuildOutput>
    <PackageId>ShogunKub.Cyriller</PackageId>
    <Version>0.2.0</Version>
    <Description>Библиотека для склонения существительных, прилагательных, чисел и личных имен русского языка по падежам.</Description>
    <Company>https://github.com/shogun-kub</Company>
    <Copyright>Copyright © Konstantin Mi 2014-2020</Copyright>
    <PackageLicenseExpression>LGPL-3.0-only</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/shogun-kub/Cyriller</PackageProjectUrl>
    <RepositoryUrl>https://github.com/shogun-kub/Cyriller</RepositoryUrl>
    <Authors>Konstantin Mi (miyconst), Mikhail Rozhkov (shogun-kub)</Authors>
    <PackageTags>склонение существительное прилагательное число имя падеж</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Первый выпуск форка: целевые платформы .NET 10 и .NET Standard 2.1; словарь возвращает определённый род существительного; исправлено склонение имён на -ша.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="App_Data\adjectives.gz" />
    <None Remove="App_Data\nouns.gz" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="App_Data\adjectives.gz" />
    <EmbeddedResource Include="App_Data\nouns.gz" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cyriller.Model\Cyriller.Model.csproj" PrivateAssets="All"></ProjectReference>
    <ProjectReference Include="..\Cyriller.Rule\Cyriller.Rule.csproj" PrivateAssets="All"></ProjectReference>
  </ItemGroup>


  <Target Name="CopyProjectReferencesToPackage" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths-&gt;WithMetadataValue('ReferenceSourceTarget', 'ProjectReference'))" />
    </ItemGroup>
  </Target>
</Project>
